# Kopieer dit bestand naar ".env" en vul je eigen gegevens in.
# Het .env-bestand wordt nooit gecommit (staat in .gitignore).

# -- Database --
DATABASE_URL=sqlite:///./data/admin.db

# -- Basecone API --
# Vraag deze aan bij Basecone (Wolters Kluwer) support / developer portal.
# BASECONE_TOKEN_URL en BASECONE_API_BASE_URL zijn een aanname op basis van
# de gangbare OAuth2 client-credentials flow -- controleer dit tegen de
# documentatie/mail die je van Basecone krijgt en pas aan indien nodig.
BASECONE_TOKEN_URL=https://identity.basecone.com/connect/token
BASECONE_API_BASE_URL=https://api.basecone.com
BASECONE_CLIENT_ID=
BASECONE_CLIENT_SECRET=
BASECONE_ADMINISTRATION_ID=
# Endpoint-pad voor bankafschriftregels; {administration_id} wordt ingevuld.
# Controleer dit tegen de Basecone API-documentatie.
BASECONE_BANK_TRANSACTIONS_PATH=/v1/administrations/{administration_id}/bankstatementlines

# -- Mailbox (Microsoft Graph API) waar facturen als PDF-bijlage binnenkomen --
# Zie README voor de Azure AD app-registratie stappen (client_id/secret hier
# zijn NIET je Microsoft 365-wachtwoord, maar een aparte OAuth2 app-sleutel).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=facturen@jouwfietsenwinkel.nl
GRAPH_MAIL_FOLDER=inbox

# -- Matching --
MATCH_AMOUNT_TOLERANCE_CENTS=1
MATCH_DATE_WINDOW_DAYS=60

# -- Sync --
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_DAYS=120

# -- Dashboard login (verander dit!) --
DASHBOARD_USERNAME=sacha
DASHBOARD_PASSWORD=changeme
