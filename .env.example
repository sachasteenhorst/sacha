# Kopieer dit bestand naar ".env" en vul je eigen gegevens in.
# Het .env-bestand wordt nooit gecommit (staat in .gitignore).

# -- Database --
DATABASE_URL=sqlite:///./data/admin.db

# -- Basecone API --
# Uitgezet: Basecone heeft geen bankafschriftregels (alleen
# inkoop/verkoopboekingen), dus is geen bruikbare bron voor de
# banktransacties -- die komen nu uit een upload (zie README). Alleen op
# BASECONE_ENABLED=true zetten als je hier ooit iets anders (documenten/
# boekingen) mee wilt doen en echte API-toegang hebt.
BASECONE_ENABLED=false
# Vraag deze aan bij Basecone (Wolters Kluwer) support / developer portal.
# BASECONE_TOKEN_URL en BASECONE_API_BASE_URL zijn een aanname op basis van
# de gangbare OAuth2 client-credentials flow -- controleer dit tegen de
# documentatie/mail die je van Basecone krijgt en pas aan indien nodig.
BASECONE_TOKEN_URL=https://identity.basecone.com/connect/token
BASECONE_API_BASE_URL=https://api.basecone.com
BASECONE_CLIENT_ID=
BASECONE_CLIENT_SECRET=
BASECONE_ADMINISTRATION_ID=
# Endpoint-pad voor bankafschriftregels; {administration_id} wordt ingevuld.
# Controleer dit tegen de Basecone API-documentatie.
BASECONE_BANK_TRANSACTIONS_PATH=/v1/administrations/{administration_id}/bankstatementlines

# -- Mailbox (Microsoft Graph API) waar facturen als PDF-bijlage binnenkomen --
# Zie README voor de Azure AD app-registratie stappen. Geen client secret
# nodig -- dit is een "public client" app (device code login), zie
# scripts/graph_login.py.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Eén adres, of een kommagescheiden lijst als facturen op meerdere adressen
# binnenkomen (bijv. facturen@jouwfietsenwinkel.nl,info@jouwfietsenwinkel.nl).
# Op adressen buiten "facturen@" wordt strenger gefilterd: alleen
# bijlagen die op een factuur/creditnota/specificatie lijken worden
# meegenomen (zie README), zodat gewone e-mail niet als "openstaande
# factuur" in het dashboard belandt.
GRAPH_MAILBOX=facturen@jouwfietsenwinkel.nl
GRAPH_MAIL_FOLDER=inbox

# -- Matching --
MATCH_AMOUNT_TOLERANCE_CENTS=1
MATCH_DATE_WINDOW_DAYS=60
# Leveranciers/afzenders (kommagescheiden, hoofdletterongevoelig) van wie
# geld OP de rekening komt (in plaats van een rekening die jij betaalt).
# "Mobility Services" is het Lease a Bike-platform: hun "factuur" is een
# verkoopfactuur die wij naar VWPFS sturen, dus geld dat WIJ krijgen.
INCOMING_SUPPLIERS=ENRA,HelloRider,Mobility Services
# Een factuurnummer-match hoeft niet exact op het bedrag uit te komen --
# een kleine betalingskorting (vroegbetalingskorting) wordt geaccepteerd,
# tot maximaal het KLEINSTE van dit percentage of dit vaste bedrag.
PAYMENT_DISCOUNT_PERCENT=3.0
PAYMENT_DISCOUNT_MAX_CENTS=2500
# Namen van je eigen bedrijf (kommagescheiden, hoofdletterongevoelig,
# vergeleken met de afzendernaam). Een verkoopfactuur die je zelf verstuurd
# hebt en die in een gescande mailbox belandt (bijv. gearchiveerd/CC'd naar
# info@) telt hiermee nooit mee als openstaande inkoopfactuur. Afzenders op
# hetzelfde domein als GRAPH_MAILBOX worden hier altijd al automatisch bij
# herkend, ook zonder dit in te vullen.
OWN_COMPANY_NAMES=Van der Linden Tweewielers,Hing B.V.

# -- Basecone doorsturen --
# Elke inkoopfactuur/creditnota/specificatie moet hier terechtkomen, anders
# ziet de boekhouder 'm niet. Leeg zet de hele Basecone-doorstuurcontrole uit
# (dashboard toont dan overal "onbekend").
BASECONE_FORWARD_ADDRESS=vdlg.161024@mailvanderlaangroep.nl
# Leveranciers/afzenders (kommagescheiden, hoofdletterongevoelig) wier
# documenten NOOIT naar Basecone mogen, ook al ziet extractie ze aan voor
# een gewone uitgaande inkoopfactuur. Standaard de Lease a Bike-"facturen"
# en HelloRider: die zijn kopieën van onze eigen kassaverkoop via
# CycleSoftware, die al automatisch via Twinfield wordt geboekt --
# nogmaals doorsturen is een dubbele boeking.
BASECONE_EXCLUDE_SUPPLIERS=Mobility Services,Lease a Bike,VWPFS,HelloRider,CycleSoftware
# Uitzondering op "een inkomend document wordt nooit doorgestuurd":
# leveranciers (kommagescheiden, hoofdletterongevoelig) van wie een
# INKOMEND document wél naar Basecone moet. Standaard ENRA: hun
# rekening-courantoverzicht is, ook al is het geld inkomend, wel degelijk
# een document dat de boekhouder moet zien (geen CycleSoftware-kopie).
BASECONE_INCLUDE_INCOMING=ENRA
# Uit (false) tot je de Mail.Send/Mail.Send.Shared-permissie hebt toegevoegd
# in Entra EN opnieuw bent ingelogd met scripts/graph_login.py (zie README)
# -- zolang dit false is, verstuurt de app nooit iets automatisch; je stuurt
# dan zelf door via de knoppen in het dashboard.
AUTO_FORWARD_BASECONE=false
# Alleen documenten ontvangen op/na deze datum worden automatisch verstuurd;
# alles ervoor is "backlog" (zie README). Leeg = de app onthoudt zelf de
# dag waarop je AUTO_FORWARD_BASECONE voor het eerst op true zette.
AUTO_FORWARD_FROM_DATE=
# Veiligheidsgrens: nooit meer dan dit aantal in één sync automatisch versturen.
AUTO_FORWARD_MAX_PER_SYNC=50

# -- Sync --
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_DAYS=120

# -- Dashboard login (verander dit!) --
DASHBOARD_USERNAME=sacha
DASHBOARD_PASSWORD=changeme
# Alleen gebruikt om de "Click"-link in een pushmelding te bouwen.
DASHBOARD_PUBLIC_URL=https://srv2014936.hstgr.cloud

# -- "Nog te betalen" --
# Leveranciers (kommagescheiden, hoofdletterongevoelig) die bekend staan om
# automatische incasso -- hun facturen komen nooit in "Nog te betalen" te
# staan. Wordt aangevuld door: tekst in de factuur zelf ("incasso",
# "automatisch afgeschreven", "machtiging"), een bestaande banktransactie
# van deze leverancier die al een incasso blijkt te zijn (Rabobank-code
# ei/id, of Machtigingskenmerk/Incassant ID ingevuld), en de knop "Loopt
# via incasso" in het dashboard (onthouden per leverancier).
PAY_INCASSO_SUPPLIERS=Accell,Gazelle,Pon,Giant,Kruitbosch,Odido,Exact,ENRA
# Uitzondering: deze leveranciers zijn NOOIT incasso, ook niet als ze op
# PAY_INCASSO_SUPPLIERS staan of een tekst-/banksignaal geven.
PAY_MANUAL_SUPPLIERS=

# -- Push-meldingen (ntfy.sh, of je eigen ntfy-server) --
NTFY_URL=https://ntfy.sh
# Verplicht om meldingen te ontvangen. Geheim en lang/willekeurig -- ntfy-
# topics zijn wereldwijd uniek en zonder toegangscontrole leesbaar voor wie
# de naam raadt (kies bijv. iets als "vdlg-facturen-8f3k2m9x").
NTFY_TOPIC=
# Alleen nodig als je je eigen ntfy-server met authenticatie draait.
NTFY_TOKEN=

# -- Ponto Connect (automatische bankkoppeling) --
# Leeg = uit; de app blijft dan draaien op handmatige CSV/CAMT.053/MT940-
# upload. Maak een "Integration" aan in het Ponto-dashboard (OAuth2 Client
# Credentials, voor je EIGEN rekening) en vul hier de gegevens in. Zie
# README voor de stappen en een belangrijke kanttekening: dit is nog niet
# tegen een echte Ponto-integratie getest.
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
# Alleen invullen als jouw integratie mTLS/HTTP-signatures eist (zie Ponto-
# dashboard) -- de meeste Client Credentials-integraties hebben dit niet nodig.
PONTO_CERT_PATH=
PONTO_KEY_PATH=
PONTO_KEY_PASSWORD=
PONTO_SIGNATURE_KEY_ID=

# -- CycleSoftware (kassasysteem) --
# Nog niet in gebruik -- placeholder voor een toekomstige live koppeling
# (CS Connect). Vooralsnog upload je de verkoopfacturen-export handmatig
# (CSV/XLSX) via de knop op het dashboard.
CS_API_KEY=
CS_API_BASE_URL=
